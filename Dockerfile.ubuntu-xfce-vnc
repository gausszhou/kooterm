FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    DISPLAY=:1 \
    VNC_PORT=5900 \
    VNC_RESOLUTION=1280x720 \
    VNC_PW=vncpassword

RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    ca-certificates \
    curl \
    sudo \
    locales \
    && ln -fs /usr/share/zoneinfo/$TZ /etc/localtime && dpkg-reconfigure -f noninteractive tzdata \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb /usr/share/doc /usr/share/man /usr/share/info

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    xfce4 \
    xfce4-terminal \
    xorg \
    dbus-x11 \
    tigervnc-standalone-server \
    tigervnc-tools \
    btop \
    && apt-get autoremove -y \
    && curl -fsSL https://github.com/fastfetch-cli/fastfetch/releases/latest/download/fastfetch-linux-amd64.deb -o /tmp/fastfetch.deb \
    && dpkg -i /tmp/fastfetch.deb \
    && rm -f /tmp/fastfetch.deb \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb /usr/share/doc /usr/share/man /usr/share/info /usr/share/locale/{??,??_??}/* /var/log/* \
    && useradd -m -s /bin/bash -G sudo user \
    && echo "user:user" | chpasswd \
    && echo "root:root" | chpasswd \
    && mkdir -p /home/user/.vnc \
    && echo "vncpassword" | tigervncpasswd -f > /home/user/.vnc/passwd \
    && chmod 600 /home/user/.vnc/passwd \
    && chown -R user:user /home/user/.vnc

USER user
WORKDIR /home/user

COPY --chown=user:user <<"EOF" /home/user/.vnc/xstartup
#!/bin/bash
export PATH=$PATH:/usr/bin
export XDG_SESSION_TYPE=x11

exec startxfce4
EOF

RUN chmod +x ~/.vnc/xstartup

USER root
COPY --chown=user:user <<"EOF" /home/user/.vnc/config
geometry=1280x720
localhost=no
EOF

EXPOSE 5900

USER user
CMD ["vncserver", ":", "1", "-fg", "-geometry", "1280x720", "-localhost", "no"]
