{
  "name": "@kooterm/monorepo",
  "version": "1.0.0",
  "description": "Kooterm Monorepo - 包含前端门户和后端服务",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "sh shells/build.sh",
    "build:common": "pnpm --filter @kooterm/common build",
    "test:common": "pnpm --filter @kooterm/common test",
    "dev:portal": "pnpm --filter @kooterm/portal dev",
    "dev:service": "pnpm --filter @kooterm/service dev",
    "start": "pnpm --filter @kooterm/service start",
    "lint": "pnpm --parallel lint",
    "clean": "pnpm --parallel clean && rm -rf packages/*/node_modules"
  },
  "engines": {
    "pnpm": ">=8.0.0",
    "node": ">=18.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": ["node-pty"]
  },
  "keywords": [
    "monorepo",
    "kooterm",
    "terminal",
    "express",
    "socket.io"
  ],
  "author": "",
  "license": "MIT"
}