FROM consol/debian-xfce-vnc

USER 0

# 1a. 更新 apt
RUN apt-get update

# 1b. SSH
RUN apt-get install -y openssh-server sudo locales

# 1c. 下载工具
RUN apt-get install -y wget curl

# 1d. 开发工具
RUN apt-get install -y git build-essential ca-certificates

# 1e. 终端工具
RUN apt-get install -y btop neofetch

# 2. Locale
RUN sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
    && locale-gen \
    && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# 3. SSH
RUN mkdir -p /var/run/sshd \
    && echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config \
    && echo "PermitRootLogin yes" >> /etc/ssh/sshd_config \
    && echo "AcceptEnv LANG LC_ALL" >> /etc/ssh/sshd_config

# 4. Go 1.26.1
RUN wget -q https://go.dev/dl/go1.26.1.linux-amd64.tar.gz -O /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz

# 5. Node.js
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get purge -y nodejs || true \
    && apt-get update && apt-get install -y nodejs

# 6. PATH
RUN echo 'export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"' > /etc/profile.d/dev-env.sh

# 7. 用户
RUN useradd -m -s /bin/bash user \
    && echo "user:user" | chpasswd \
    && usermod -aG sudo user \
    && echo '%sudo ALL=(ALL) NOPASSWD: ALL' >> /etc/sudoers

# 8. 清理 apt 缓存
RUN apt-get clean && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

EXPOSE 22 5901
