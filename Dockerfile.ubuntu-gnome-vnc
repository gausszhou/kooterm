# syntax=docker/dockerfile:1
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Shanghai \
    DISPLAY=:1 \
    VNC_PORT=5900 \
    VNC_RESOLUTION=1280x720 \
    VNC_PW=vncpassword

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    echo "deb http://archive.ubuntu.com/ubuntu noble universe" > /etc/apt/sources.list.d/universe.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    tzdata \
    ca-certificates \
    curl \
    sudo \
    locales \
    gnome-session \
    gnome-shell \
    gnome-terminal \
    xorg \
    dbus \
    gsettings-desktop-schemas \
    tigervnc-standalone-server \
    tigervnc-tools \
    fastfetch \
    btop \
    && ln -fs /usr/share/zoneinfo/$TZ /etc/localtime \
    && dpkg-reconfigure -f noninteractive tzdata \
    && locale-gen en_US.UTF-8 \
    && apt-get autoremove -y \
    && rm -rf /usr/share/doc /usr/share/man /usr/share/info /usr/share/locale/{??,??_??}/* /usr/share/gnome/help /var/log/* \
    && useradd -m -s /bin/bash -G sudo user \
    && echo "user:user" | chpasswd \
    && echo "root:root" | chpasswd \
    && mkdir -p /home/user/.vnc \
    && echo "vncpassword" | tigervncpasswd -f > /home/user/.vnc/passwd \
    && chmod 600 /home/user/.vnc/passwd \
    && chown -R user:user /home/user/.vnc

ENV LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

USER user
WORKDIR /home/user

RUN mkdir -p /home/user/.vnc && \
    { echo '#!/bin/bash'; \
      echo 'export PATH=$PATH:/usr/bin'; \
      echo 'export XDG_SESSION_TYPE=x11'; \
      echo 'export GNOME_SHELL_SESSION_MODE=ubuntu'; \
      echo 'export XDG_CURRENT_DESKTOP=ubuntu:GNOME'; \
      echo 'export XDG_CONFIG_DIRS=/etc/xdg/xdg-ubuntu:/etc/xdg'; \
      echo ''; \
      echo 'exec gnome-session'; \
    } > /home/user/.vnc/xstartup && \
    chmod +x /home/user/.vnc/xstartup && \
    { echo 'geometry=1280x720'; \
      echo 'localhost=no'; \
    } > /home/user/.vnc/config

EXPOSE 5900

CMD ["vncserver", ":", "1", "-fg", "-geometry", "1280x720", "-localhost", "no"]
